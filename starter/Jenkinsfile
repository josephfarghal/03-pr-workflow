pipeline {
    agent any
    tools {
        jdk "JDK21"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build JAR') {
            steps {
                dir('starter') {
                    sh 'mvn -B package'
                }
            }
        }
        stage('Build Image') {
            steps {
                dir('starter') {
                    sh 'test -f target/team-skeleton-0.1.0.jar'
                    sh 'docker build -t team-skeleton .'
                }
            }
        }
        stage('Smoke Test') {
            steps {
                sh 'docker run --rm team-skeleton'
            }
        }
    }
}
